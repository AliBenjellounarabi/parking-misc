{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      "admins": {
        "$account": {
          ".read": "auth != null && auth.uid === $account && auth.token.firebase.sign_in_provider === 'password'"
        }
      }
    },
    "cards": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roles/admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roles/admins').child(auth.uid).val() === true && newData.exists() && !data.exists()",
        ".validate": "$uid.matches(/^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$/) && newData.hasChildren(['label', 'active', 'createdAt'])",
        "label": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80 && (!data.exists() || data.val() === newData.val())"
        },
        "active": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roles/readers').child(auth.uid).val() === true && $uid.matches(/^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$/)",
          ".validate": "newData.isBoolean()",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roles/admins').child(auth.uid).val() === true && data.exists() && newData.exists()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && data.val() === newData.val()))"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "accessEvents": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roles/admins').child(auth.uid).val() === true && query.orderByChild === 'scannedAt' && query.limitToLast !== null && query.limitToLast <= 100",
      ".indexOn": [
        "scannedAt"
      ],
      "$event": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('roles/readers').child(auth.uid).val() === true && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['uid', 'result', 'scannedAt', 'readerId'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().matches(/^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$/)"
        },
        "result": {
          ".validate": "newData.val() === 'granted' || newData.val() === 'unknown' || newData.val() === 'revoked' || newData.val() === 'unavailable'"
        },
        "scannedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "readerId": {
          ".validate": "newData.val() === auth.uid"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
